// romi config. Comments are allowed. Press ctrl-r in romi to reload after editing.
//
// Command placeholders (expanded per argument, so spaces in paths are safe):
//   {rom}   full path to the ROM        {file}  file name, e.g. "Sonic CD (USA).chd"
//   {name}  file name without extension {dir}   folder containing the ROM
//   {appid} Steam app id (Steam only)   plus anything you define in "vars".
//
// Launch modes:
//   "wait"     (default) romi shows a "now playing" screen until the game exits; output goes to
//              ~/.local/state/romi/last.log
//   "terminal" romi steps aside and the command gets the terminal (scripts, TUI games)
//   "detach"   start it and carry on (anything that returns immediately, like Steam)
{
  "roms_dir": "~/ROMs",

  // Optional: reuse names/descriptions scraped by ES-DE. Remove if you don't use ES-DE.
  "gamelists_dir": "~/ES-DE/gamelists",

  // MAME name lists shipped with ES-DE. Systems with "arcade": true use them to show real titles
  // instead of short names (sfa3u -> Street Fighter Alpha 3) and to hide BIOS/device zips.
  "arcade_db": "/usr/share/es-de/resources/MAME",

  // Optional: where ES-DE's es_systems.xml and es_find_rules.xml are, if ES-DE isn't installed in
  // the usual place. `romi init` and `romi check` use them to know systems and emulators.
  // "esde_dir": "/usr/share/es-de/resources/systems/linux",

  // Where "bios" files listed on systems are looked for (each system's ROM folder is checked too).
  // `romi check` and the TUI flag systems whose BIOS is missing.
  "bios_dirs": ["~/.config/retroarch/system"],

  "vars": {
    "cores": "~/.config/retroarch/cores"
  },

  // Where romi starts: "last_selected" (where you left off) or "last_played" (the last game you
  // played, in its system).
  "start_on": "last_selected",

  // Some systems are called different things in different places: Genesis or Mega Drive, Sega CD
  // or Mega-CD, TurboGrafx-16 or PC Engine, Super Nintendo or Super Famicom. Those left without a
  // "name" below are named for this region: "na" (North America), "eu" (Europe and most of the
  // world), "jp", or "auto" to go by your locale.
  "region": "auto",

  // Commands run when a game starts and stops, here and per system (see docs/config.md).
  // "hooks": {
  //   "on_launch": ["playerctl pause", "powerprofilesctl set performance"],
  //   "on_exit": ["powerprofilesctl set balanced"]
  // },

  "theme": {
    // Terminal palette names keep romi in sync with your terminal theme:
    // black red green yellow blue magenta cyan white, the bright_* variants, or "default".
    "accent": "blue",
    "borders": "rounded",
    "show_details": true
  },

  "controller": {
    "enabled": true,
    "swap_confirm": false,
    "require_focus": true
  },

  // How loud games played inside romi ("Play in romi", `romi run --live`) are: 0 (silent) to 100.
  "volume": 100,

  // How round the corners of a game played in romi's middle panel are, as a percentage of its
  // height: 0 is square, as the game drew it, and about 4 is an old TV's.
  "corner_radius": 0,

  // An old screen's look for a game played in romi's middle panel: "none", "scanlines", "crt"
  // (scanlines and a phosphor mask) or "lcd" (a grid between the pixels, like a handheld's).
  "screen_filter": "none",

  // A wireframe of the system (a Game Boy, for GBA games too; an NES or SNES with a TV; an arcade
  // cabinet; or a TV) that builds itself before a game played inside romi starts. "colors" lists
  // the colors it picks from, like ["#9fe3ff", "#ffb547"]; empty uses the terminal's own palette.
  "launch_animation": { "enabled": true, "colors": [] },

  "systems": [
    {
      "id": "arcade", "arcade": true, "name": "Arcade",
      "extensions": ["zip", "7z"],
      "exclude": ["naomi*.zip", "mie.zip", "segadimm.zip", "jvs13551.zip", "neogeo.zip"],
      "command": "retroarch -L {cores}/mame_libretro.so {rom}"
    },
    {
      "id": "neogeo", "arcade": true, "name": "Neo Geo",
      "extensions": ["zip", "7z", "neo"],
      "bios": ["neogeo.zip"],
      "exclude": ["neogeo.zip"],
      "command": "retroarch -L {cores}/fbneo_libretro.so {rom}"
    },
    {
      "id": "naomi", "arcade": true, "name": "NAOMI",
      "extensions": ["zip", "7z", "lst", "dat", "bin", "elf"],
      "bios": [["naomi.zip", "dc/naomi.zip"]],
      "exclude": ["naomi*.zip", "mie.zip", "segadimm.zip", "jvs13551.zip"],
      "command": "retroarch -L {cores}/flycast_libretro.so {rom}"
    },
    {
      "id": "gb", "name": "Game Boy",
      "extensions": ["gb", "zip", "7z"],
      "command": "retroarch -L {cores}/mgba_libretro.so {rom}"
    },
    {
      "id": "gbc", "name": "Game Boy Color",
      "extensions": ["gbc", "gb", "zip", "7z"],
      "command": "retroarch -L {cores}/mgba_libretro.so {rom}"
    },
    {
      "id": "gba", "name": "Game Boy Advance",
      "extensions": ["gba", "zip", "7z"],
      "command": "retroarch -L {cores}/mgba_libretro.so {rom}"
    },
    {
      "id": "nds", "name": "Nintendo DS",
      "extensions": ["nds", "dsi", "zip", "7z"],
      "command": "melonDS -f {rom}"
    },
    {
      "id": "snes",
      "extensions": ["sfc", "smc", "zip", "7z"],
      "command": "retroarch -L {cores}/bsnes_hd_beta_libretro.so {rom}"
    },
    {
      "id": "n64", "name": "Nintendo 64",
      "extensions": ["z64", "n64", "v64", "zip", "7z"],
      "command": "retroarch -L {cores}/mupen64plus_next_libretro.so {rom}"
    },
    {
      "id": "gc", "name": "GameCube",
      "extensions": ["rvz", "iso", "gcm", "gcz", "ciso", "wbfs", "wia", "m3u"],
      "command": "dolphin-emu -b -e {rom}"
    },
    {
      "id": "megadrive",
      "extensions": ["md", "gen", "smd", "bin", "32x", "sms", "gg", "zip", "7z"],
      "command": "retroarch -L {cores}/genesis_plus_gx_libretro.so {rom}"
    },
    {
      "id": "scd",
      "extensions": ["chd", "cue", "m3u", "iso"],
      // US, Europe, Japan: games need the one for their region.
      "bios": [["bios_CD_U.bin", "bios_CD_E.bin", "bios_CD_J.bin"]],
      "command": "retroarch -L {cores}/genesis_plus_gx_libretro.so {rom}"
    },
    {
      "id": "saturn", "name": "Saturn",
      "extensions": ["chd", "cue", "m3u", "iso", "zip", "7z"],
      "bios": [["sega_101.bin", "mpr-17933.bin"]],
      "command": "retroarch -L {cores}/mednafen_saturn_libretro.so {rom}"
    },
    {
      "id": "dreamcast", "name": "Dreamcast",
      "extensions": ["chd", "cdi", "gdi", "cue", "m3u", "iso", "zip", "7z"],
      "exclude": ["naomi*.zip"],
      "command": "retroarch -L {cores}/flycast_libretro.so {rom}"
    },
    {
      "id": "pcengine",
      "extensions": ["pce", "sgx", "chd", "cue", "m3u", "zip", "7z"],
      "command": "retroarch -L {cores}/mednafen_pce_fast_libretro.so {rom}"
    },
    {
      "id": "ngpc", "name": "Neo Geo Pocket Color",
      "extensions": ["ngp", "ngc", "ngpc", "zip", "7z"],
      "recursive": true,
      "command": "retroarch -L {cores}/mednafen_ngp_libretro.so {rom}"
    },
    {
      "id": "psx", "name": "PlayStation",
      "extensions": ["chd", "cue", "m3u", "pbp", "iso", "img", "ccd", "zip", "7z"],
      "bios": [["scph5501.bin", "scph5500.bin", "scph5502.bin"]],
      "command": "retroarch -L {cores}/mednafen_psx_hw_libretro.so {rom}",
      // Offered in each game's menu, with any other installed emulators ES-DE knows for the system.
      "emulators": [{ "name": "DuckStation", "command": "duckstation-qt -batch {rom}" }]
    },
    {
      "id": "ps2", "name": "PlayStation 2",
      "extensions": ["iso", "chd", "cso", "zso", "gz", "m3u"],
      "bios": ["~/.config/PCSX2/bios/*.bin"],
      "command": "pcsx2-qt -batch {rom}"
    },
    {
      "id": "shell", "name": "Scripts",
      "extensions": ["sh"],
      "command": "bash {rom}",
      "cwd": "{dir}",
      "mode": "terminal"
    }
  ],

  // Anything else: native ports, scripts, flatpaks...
  //   { "name": "My Game", "command": "./run.sh", "cwd": "~/Games/my-game", "system": "PC" }
  "games": [],

  "steam": {
    "enabled": true,
    "exclude": []
  },

  // Box art, used by `romi scrape`. Art already on disk (ES-DE, Skyscraper, Steam) is used in
  // place; the rest is downloaded from libretro's thumbnail server and Steam's CDN into
  // ~/.cache/romi/art. Set "art": "/path/to/image.png" on any game or override to pick your own.
  // Systems search libretro thumbnail sets based on their id; set "libretro": ["Set Name", ...] on
  // a system to change that.
  // RetroAchievements: put your username here and your web API key (retroachievements.org →
  // Settings) in ~/.config/romi/retroachievements.key, and the details pane shows each game's
  // achievements and your progress. "badges" shows an achievement's badge in the notice when it
  // unlocks in a game played in romi.
  // "retroachievements": { "username": "you", "badges": true },

  // Where game info comes from besides ES-DE: RetroArch's databases (genre, year, players,
  // descriptions) matched by ROM checksum, plus an optional MAME category list (catver.ini) for
  // arcade genres. Get catver.ini from https://www.progettosnaps.net/catver/
  "metadata": {
    "rdb_dir": "~/.config/retroarch/database/rdb",
    "checksums": true,
    "arcade_categories": null
  },

  "art": {
    "esde_media_dir": "~/ES-DE/downloaded_media",
    "skyscraper_cache": "~/.skyscraper/cache",
    "online": true,
    // Covers in the details pane. Uses Kitty/Sixel/iTerm2 graphics when the terminal has them
    // (Ghostty, kitty, WezTerm, foot...), colored half-blocks otherwise.
    "show": true,
    // Title screens and screenshots too: scraped with the covers, and shown in turn with them.
    "screens": true
  }
}
